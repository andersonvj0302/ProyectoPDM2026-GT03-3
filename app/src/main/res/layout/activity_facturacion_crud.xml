<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#B00020"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@android:color/white"
            app:title="PROCESAR PAGO"
            app:titleCentered="true"
            app:titleTextColor="@android:color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1E1E1E"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detalle de Transacción"
                        android:textColor="#62B2FD"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:textColorHint="#AAAAAA"
                        app:hintTextColor="@android:color/white"
                        app:boxStrokeColor="#62B2FD">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etExpedienteId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="ID del Expediente de Reparación"
                            android:inputType="number"
                            android:textColor="@android:color/white"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:textColorHint="#AAAAAA"
                        app:hintTextColor="@android:color/white"
                        app:boxStrokeColor="#62B2FD">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMonto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Monto a Pagar ($)"
                            android:inputType="numberDecimal"
                            android:textColor="@android:color/white"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <CheckBox
                        android:id="@+id/cbAplicaSeguro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="¿Aplica Cobertura de Seguro?"
                        android:textColor="#62B2FD"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Seccion de seguro (Colapsable) -->
                    <LinearLayout
                        android:id="@+id/layoutSeguro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:background="#252525"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tipo de Póliza"
                            android:textColor="#CCCCCC"
                            android:layout_marginBottom="4dp"/>

                        <Spinner
                            android:id="@+id/spinnerTipoPoliza"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/rounded_input_bg"
                            android:layout_marginBottom="12dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:textColorHint="#AAAAAA"
                            app:hintTextColor="@android:color/white"
                            app:boxStrokeColor="#62B2FD">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etValorReferencia"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Monto Deducible/Franquicia ($)"
                                android:inputType="numberDecimal"
                                android:textColor="@android:color/white"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCalcularSeguro"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:backgroundTint="#6750A4"
                            android:text="APLICAR DEDUCIBLE/FRANQUICIA"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tvResultadoSeguro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Resumen Cobertura:"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modalidad/Método de Pago"
                        android:textColor="#62B2FD"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <Spinner
                        android:id="@+id/spinnerModalidad"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/rounded_input_bg"
                        android:padding="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProcesarPago"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:backgroundTint="#4CAF50"
                        android:text="COMPLETAR PAGO"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>