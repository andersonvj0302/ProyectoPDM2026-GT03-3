<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#B00020"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@android:color/white"
            app:title="VEHICULOS"
            app:titleCentered="true"
            app:titleTextColor="@android:color/white">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_profile_placeholder" />
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="NUEVO VEHÍCULO"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/InputFieldLabelStyle"
                android:text="VIN (Chasis)" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVin"
                style="@style/InputFieldStyle"
                android:hint="Ej. 1A2B3C..." />

            <TextView
                style="@style/InputFieldLabelStyle"
                android:text="Placa" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPlaca"
                style="@style/InputFieldStyle"
                android:hint="Ej. P123-456" />

            <TextView
                style="@style/InputFieldLabelStyle"
                android:text="Marca" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMarca"
                style="@style/InputFieldStyle"
                android:hint="Ej. Toyota" />

            <TextView
                style="@style/InputFieldLabelStyle"
                android:text="Modelo" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etModelo"
                style="@style/InputFieldStyle"
                android:hint="Ej. Corolla 2024" />

            <TextView
                style="@style/InputFieldLabelStyle"
                android:text="Dueño (Cliente)" />
            <Spinner
                android:id="@+id/spClientes"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_input_bg"
                android:padding="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                style="@style/SolidActionButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="GUARDAR VEHÍCULO" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>