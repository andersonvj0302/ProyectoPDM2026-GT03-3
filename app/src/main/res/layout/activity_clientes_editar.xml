<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".VehiculosCrudActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#B00020"
            app:title="CLIENTE"
            app:titleCentered="true"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@android:color/white">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_profile_placeholder"
                android:padding="4dp"
                android:background="#E1D5E7"
                app:shapeAppearanceOverlay="@style/CircleImageStyle" />
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLabelEditar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="EDITAR CLIENTE"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/InputFieldLabelStyle"
                android:text="Nombre" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombre"
                style="@style/InputFieldStyle" />

            <TextView
                style="@style/InputFieldLabelStyle"
                android:text="DUI" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDui"
                style="@style/InputFieldStyle"
                android:inputType="number" />

            <TextView
                style="@style/InputFieldLabelStyle"
                android:text="Teléfono" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTelefono"
                style="@style/InputFieldStyle"
                android:inputType="phone" />

            <TextView
                style="@style/InputFieldLabelStyle"
                android:text="Email" />
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                style="@style/InputFieldStyle"
                android:inputType="textEmailAddress" />

            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBorrar"
                    style="@style/OutlinedActionButtonStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="ELIMINAR"
                    android:textColor="#B00020"
                    app:strokeColor="#B00020" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActualizar"
                    style="@style/SolidActionButtonStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="ACTUALIZAR" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>